<?xml version="1.0" encoding="utf-8"?>
<!-- Yin-yang ☯ outline — stroke-based so Icon tint works correctly -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- outer circle outline -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:fillColor="@android:color/transparent"
        android:pathData="M12,2a10,10 0 1,0 0.001,0 z" />
    <!-- S-curve divider (top half filled) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2"
        android:fillColor="@android:color/transparent"
        android:pathData="M12,2 a5,5 0 0,1 0,10 a5,5 0 0,0 0,10" />
    <!-- small dot top (hollow) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2"
        android:fillColor="@android:color/transparent"
        android:pathData="M12,6 a1.5,1.5 0 1,0 0.001,0 z" />
    <!-- small dot bottom (filled) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,16.5 a1.5,1.5 0 1,0 0.001,0 z" />
</vector>
