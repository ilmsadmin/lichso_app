# ============================================
# Zplus Base - Backend Environment
# ============================================
# Copy this file to .env and update values
# cp .env.example .env
# ============================================

# ============================================
# Application
# ============================================
APP_NAME=Zplus Base
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_SECRET=your-super-secret-key-change-this-in-production

# ============================================
# PostgreSQL Database
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zplus_db
DB_USER=zplus_user
DB_PASSWORD=zplus_secret
DB_SSL_MODE=disable
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=5
DB_MAX_LIFETIME=300

# ============================================
# MongoDB
# ============================================
MONGODB_URI=mongodb://zplus_user:zplus_secret@localhost:27017
MONGODB_DATABASE=zplus_logs
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# ============================================
# Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-jwt-secret-key-minimum-32-characters-long
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=168h
JWT_ISSUER=zplus-base

# ============================================
# CORS
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_MAX_AGE=86400

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=60

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=console
LOG_OUTPUT=stdout
LOG_FILE_PATH=./logs/app.log

# ============================================
# File Upload
# ============================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
UPLOAD_PATH=./uploads

# ============================================
# Password Reset
# ============================================
PASSWORD_RESET_TOKEN_EXPIRY=3600
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# ============================================
# Google OAuth
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# ============================================
# SMTP Email Configuration
# ============================================
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Zplus Base
SMTP_ENCRYPTION=tls

# ============================================
# Phase 4 — AI Integration (OpenRouter.ai)
# ============================================
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_SITE_URL=https://lichso.vn
AI_SITE_NAME=LichSo.vn

# Default AI models
AI_ARTICLE_MODEL=deepseek/deepseek-chat
AI_HOROSCOPE_MODEL=anthropic/claude-sonnet-4
AI_CHAT_MODEL=openai/gpt-4o-mini

# Max tokens per request
AI_MAX_TOKENS_ARTICLE=4096
AI_MAX_TOKENS_HOROSCOPE=2048
AI_MAX_TOKENS_CHAT=1024

# Daily quota per tier (number of AI horoscope reads)
AI_RATE_HOROSCOPE_GUEST=2
AI_RATE_HOROSCOPE_FREE=5
AI_RATE_HOROSCOPE_PREMIUM=30

# Monthly budget cap in USD (0 = no cap)
AI_MONTHLY_BUDGET_CAP=50.0

# Pexels API key for auto-fetching article featured images
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=
