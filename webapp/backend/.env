# ============================================
# Lịch Số - Backend Environment
# ============================================

# ============================================
# Application
# ============================================
APP_NAME=Lịch Số
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_SECRET=change-me-app-secret-dev

# ============================================
# PostgreSQL Database
# ============================================
DB_HOST=localhost
DB_PORT=5434
DB_NAME=zplus_lichso_db
DB_USER=zplus_user
DB_PASSWORD=change-me-db-password
DB_SSL_MODE=disable
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=5
DB_MAX_LIFETIME=300

# ============================================
# MongoDB
# ============================================
MONGODB_URI=mongodb://zplus_user:change-me-mongo-password@localhost:27019
MONGODB_DATABASE=zplus_lichso_logs
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# ============================================
# Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=change-me-jwt-secret-minimum-32-chars
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=168h
JWT_ISSUER=zplus-lichso

# ============================================
# CORS
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:80
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_MAX_AGE=86400

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=60

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=console
LOG_OUTPUT=stdout
LOG_FILE_PATH=./logs/app.log

# ============================================
# File Upload
# ============================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
UPLOAD_PATH=./uploads

# ============================================
# Password Reset
# ============================================
PASSWORD_RESET_TOKEN_EXPIRY=3600
PASSWORD_RESET_URL=http://localhost:3001/reset-password

# ============================================
# Google OAuth
# ============================================
GOOGLE_CLIENT_ID=929152007577-t4eegprgf4i5oudfq89860f006uir7dv.apps.googleusercontent.com


# ============================================
# SMTP Email Configuration
# ============================================
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Lịch Số
SMTP_ENCRYPTION=tls

# Pexels API Key
PEXELS_API_KEY=

# ============================================
# AI / OpenRouter Configuration
# ============================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_HOROSCOPE_MODEL=anthropic/claude-sonnet-4
AI_ARTICLE_MODEL=anthropic/claude-sonnet-4
AI_CHAT_MODEL=anthropic/claude-sonnet-4
